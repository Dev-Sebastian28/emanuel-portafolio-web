# Copiar este archivo como .env y llenar los valores. El .env nunca se sube a GitHub.

# Base de datos PostgreSQL. En local se usa Postgres.app.
# La página publicada usa Neon y sus datos van en otro archivo, .env.produccion, que
# tampoco se sube (ver "Base de datos de la página publicada" en CLAUDE.md).
DATABASE_URL=postgres://USUARIO@127.0.0.1:5432/emanuel_portafolio

# Clave secreta del panel. Generar una larga y aleatoria (por ejemplo: openssl rand -hex 32).
PAYLOAD_SECRET=

# Dirección pública de la página (sin barra al final).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Usuario de prueba que crea "npm run seed" para entrar al panel en local.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Almacenamiento de fotos y videos en Cloudflare R2 (compatible con S3).
# Si están vacías, los archivos se guardan en la carpeta /media del computador.
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Dirección pública de R2 (sin barra al final). Con ella, las fotos y videos se piden
# directo a R2; la necesita la página publicada en Cloudflare.
S3_URL_PUBLICA=

# Solo en el panel publicado (Render): el "deploy hook" de Cloudflare para que la página
# se vuelva a armar sola cuando se publica algo. En el computador va vacía.
AVISO_PUBLICAR=
